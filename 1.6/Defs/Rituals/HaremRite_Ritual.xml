<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <PreceptDef>
    <defName>HLR_HaremRitePrecept</defName>
    <label>harem rite</label>
    <description>A private orgy for the leader and their harem. Only the leader may organize it, and only the leader's spouses may join. Participants will ignore any sexual preferences during the event's duration.</description>
    <issue>Ritual</issue>
    <preceptClass>Precept_Ritual</preceptClass>
    <visible>true</visible>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <selectionWeight>1.0</selectionWeight>
    <ritualPatternBase>HLR_HaremRitePattern</ritualPatternBase>
    <iconPath>UI/Rituals/CelebrationOrgy</iconPath>
    <ignoreNameUniqueness>false</ignoreNameUniqueness>
    <requiredMemes>
      <li>LeadersHarem</li>
    </requiredMemes>
  </PreceptDef>

  <RitualPatternDef>
    <defName>HLR_HaremRitePattern</defName>
    <ritualOnlyForIdeoMembers>true</ritualOnlyForIdeoMembers>
    <ritualBehavior>HLR_HaremRiteBehavior</ritualBehavior>
    <ritualObligationTargetFilter>AnyIdeoBuildingOrRitualSpot</ritualObligationTargetFilter>
    <ritualTargetFilter>IdeoBuildingOrRitualSpot</ritualTargetFilter>
    <alwaysStartAnytime>true</alwaysStartAnytime>
    <ritualOutcomeEffect>HLR_HaremRiteOutcome</ritualOutcomeEffect>
    <playsIdeoMusic>false</playsIdeoMusic>
  </RitualPatternDef>

  <RitualBehaviorDef>
    <defName>HLR_HaremRiteBehavior</defName>
    <workerClass>VanillaMemesExpanded.RitualBehaviorWorker_Orgy</workerClass>
    <durationTicks>7500</durationTicks>
    <spectatorFilter Class="HaremLeaderRite.RitualSpectatorFilter_HaremSpouse">
      <description>Participants must be adult spouses of the leader.</description>
    </spectatorFilter>
    <roles>
      <li Class="VanillaMemesExpanded.RitualRoleTag_Adult">
        <label>leader</label>
        <tag>Leader</tag>
        <id>leader</id>
        <precept>IdeoRole_Leader</precept>
        <required>True</required>
        <substitutable>false</substitutable>
        <maxCount>1</maxCount>
        <countsAsParticipant>true</countsAsParticipant>
      </li>
    </roles>
    <spectatorsLabel>Spouses</spectatorsLabel>
    <spectatorGerund>participate</spectatorGerund>
    <stages>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <essential>True</essential>
        <allowedSpectateSidesOverride>Vertical</allowedSpectateSidesOverride>
        <spectateDistanceOverride>1</spectateDistanceOverride>
        <spectatorsRequired>true</spectatorsRequired>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>0.1</percentage>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>leader</roleId>
            <dutyDef>SpeakOnCell_Leader</dutyDef>
            <speakerInteraction>Speech_Leader</speakerInteraction>
            <customPositions>
              <li Class="RitualPosition_BesideThing" />
            </customPositions>
          </li>
        </roleBehaviors>
      </li>
      <li>
        <defaultDuty>VME_NakedPartyDance</defaultDuty>
        <essential>True</essential>
        <allowedSpectateSidesOverride>Vertical</allowedSpectateSidesOverride>
        <spectateDistanceOverride>1</spectateDistanceOverride>
        <spectatorsRequired>true</spectatorsRequired>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>0.9</percentage>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>leader</roleId>
            <dutyDef>VME_NakedPartyDance</dutyDef>
          </li>
        </roleBehaviors>
      </li>
    </stages>
  </RitualBehaviorDef>

  <RitualOutcomeEffectDef>
    <defName>HLR_HaremRiteOutcome</defName>
    <description>Every participant will get a "got some lovin'" memory, but the negative effects of a bad quality rite will be much more severe than usual. Depending on ritual quality, participants will get between {MINMOOD} and {MAXMOOD} mood for {MOODDAYS} days.\nNote that all participants must be spouses of the leader.</description>
    <workerClass>VanillaMemesExpanded.RitualOutcomeEffectWorker_Orgy</workerClass>
    <comps>
      <li Class="RitualOutcomeComp_RolePresentNotSubstituted">
        <roleId>leader</roleId>
        <label>leader present</label>
        <qualityOffset>0.25</qualityOffset>
      </li>
      <li Class="RitualOutcomeComp_RoomStat">
        <label>room impressiveness</label>
        <statDef>Impressiveness</statDef>
        <curve>
          <points>
            <li>0,  0</li>
            <li>50,  0.1</li>
            <li>120, 0.2</li>
          </points>
        </curve>
      </li>
      <li Class="RitualOutcomeComp_PawnStatScaled">
        <label>{PAWN_labelShort}'s social impact</label>
        <labelAbstract>leader's social impact</labelAbstract>
        <roleId>leader</roleId>
        <statDef>SocialImpact</statDef>
        <curve>
          <points>
            <li>(0.2,  0.0)</li>
            <li>(0.6,  0.18)</li>
            <li>(1.0, 0.25)</li>
            <li>(1.5, 0.3)</li>
          </points>
        </curve>
      </li>
      <li Class="RitualOutcomeComp_ParticipantCount">
        <label>participant count</label>
        <curve>
          <points>
            <li>(1,  0.0)</li>
            <li>(3,  0.18)</li>
            <li>(5, 0.25)</li>
          </points>
        </curve>
      </li>
    </comps>
    <outcomeChances>
      <li>
        <label>Grotesque</label>
        <chance>0.05</chance>
        <memory>VME_GrotesqueOrgy</memory>
        <description>The {0} was grotesque! When you think of an orgy, you tend to imagine attractive people. This was... the entire opposite. The mental images will take a while to go away.</description>
        <positivityIndex>-2</positivityIndex>
      </li>
      <li>
        <label>Awkward</label>
        <chance>0.05</chance>
        <memory>VME_AwkwardOrgy</memory>
        <description>The {0} was awkward. Everyone sat around not knowing exactly what to do, naked bodies laying everywhere. Quite disappointing.</description>
        <positivityIndex>-1</positivityIndex>
      </li>
      <li>
        <label>Sexy</label>
        <chance>0.65</chance>
        <memory>VME_SexyOrgy</memory>
        <description>The {0} was very sexy. The leader and their harem gave themselves to each other in an expression of their deepest passions.</description>
        <positivityIndex>1</positivityIndex>
      </li>
      <li>
        <label>Exhilarating</label>
        <chance>0.25</chance>
        <memory>VME_ExhilaratingOrgy</memory>
        <description>The {0} was exhilarating! A barrage of ecstasy unlike no other made their bodies tremble with barely concealed excitement.</description>
        <positivityIndex>2</positivityIndex>
      </li>
    </outcomeChances>
  </RitualOutcomeEffectDef>

</Defs>
